<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="za.co.pantrywise"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_pantrywise"
        android:label="PantryWise"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.PantryWise" >
        <activity
            android:name="za.co.pantrywise.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="za.co.pantrywise.RecipeDetailActivity"
            android:exported="false" />
        <activity
            android:name="za.co.pantrywise.SuggestedRecipesActivity"
            android:exported="false" />
        <activity
            android:name="za.co.pantrywise.IngredientFormActivity"
            android:exported="false" />
        <activity
            android:name="za.co.pantrywise.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>